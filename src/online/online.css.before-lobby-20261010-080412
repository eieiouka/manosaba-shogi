.online-bar{position:relative;z-index:5;text-align:center;padding:10px 16px;background:#211926;color:#fff;font-weight:700;font-size:18px}.online-bar span{display:block;font-size:13px;color:#ffc2c2}.online-lobby{position:fixed;inset:0;z-index:100;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(12,8,20,.92);color:#fff;gap:16px}.online-lobby p{font-size:20px}.online-lobby button{padding:12px 32px;border:1px solid #ddd;border-radius:8px;background:#342840;color:#fff;font-size:16px;cursor:pointer}.online-lobby button:disabled{opacity:.5}
